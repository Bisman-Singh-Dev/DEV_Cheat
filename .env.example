# Dev_Cheat Configuration
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-3.8-flash, gemini-2.5-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-3.8-flash

# Screen scan interval in seconds (default: 2.0)
SCAN_INTERVAL=2.0

# Auto-solve when a single question is detected (true/false)
AUTO_SOLVE_SINGLE=true

# Server Port for Localhost Web Dashboard
PORT=5055
HOST=127.0.0.1

# Enable Desktop Transparent HUD Overlay (true/false)
ENABLE_DESKTOP_OVERLAY=true
